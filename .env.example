# Servis portlari
SEARCH_SERVICE_PORT=8081
CART_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084

# Servisler arasi URL'ler (local gelistirme - servisler ayni makinede ayri ayri calisirken)
SEARCH_SERVICE_URL=http://localhost:8081
CART_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084

# Docker Compose network'u icinde servisler arasi URL'ler (container-to-container, servis adiyla)
SEARCH_SERVICE_DOCKER_URL=http://search-service:8081
CART_SERVICE_DOCKER_URL=http://cart-service:8082
INVENTORY_SERVICE_DOCKER_URL=http://inventory-service:8084

# Chaos / hata enjeksiyonu (Faz 15'te kullanilacak, varsayilan kapali)
CHAOS_ENABLED=false

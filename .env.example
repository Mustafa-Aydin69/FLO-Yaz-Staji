# Servis portlari
SEARCH_SERVICE_PORT=8081
CART_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# Servisler arasi URL'ler (local gelistirme - servisler ayni makinede ayri ayri calisirken)
SEARCH_SERVICE_URL=http://localhost:8081
CART_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084

# Docker Compose network'u icinde servisler arasi URL'ler (container-to-container, servis adiyla)
SEARCH_SERVICE_DOCKER_URL=http://search-service:8081
CART_SERVICE_DOCKER_URL=http://cart-service:8082
INVENTORY_SERVICE_DOCKER_URL=http://inventory-service:8084

# Chaos / hata enjeksiyonu (Faz 15'te kullanilacak, varsayilan kapali)
CHAOS_ENABLED=false

# OpenTelemetry tracing (Faz 8-9) - tum servislerde ortak varsayilanlar, konsola (logging) trace basar
# Not: OTEL_SERVICE_NAME kasitli olarak burada YOK. Her servis kendi adini application.yml'deki
# varsayilanla (search-service/cart-service/payment-service/inventory-service) zaten dogru ayarliyor.
# Bunu tek bir .env degeriyle paylasmak calisan TUM servisleri ayni isimle raporlatir; tek bir servisi
# hedefleyen bir override gerekirse infra/docker-compose.yml'deki o servisin environment: blogunda ayarlanmali.
OTEL_TRACES_EXPORTER=logging
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_SPRING_WEBMVC_ENABLED=true
